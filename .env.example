# =============================================================================
# Coding-Assistants Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# General Configuration
# =============================================================================
APP_ENV=development                    # development, staging, production
DEBUG_MODE=false
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# =============================================================================
# LLM Provider API Keys (see src-tauri/src/llm_client.rs)
# =============================================================================
OPENAI_API_KEY=
GOOGLE_GENAI_API_KEY=
ANTHROPIC_API_KEY=

# =============================================================================
# Docs website (infra/docker/, docs/website/)
# =============================================================================
DOCS_PORT=8080

# =============================================================================
# Linux / WebKitGTK rendering workaround
# =============================================================================
# WebKitGTK 2.48+ uses DMA-BUF buffer sharing on Wayland by default.
# On NVIDIA + Wayland this causes GPU pipeline stalls when the Tauri window is
# large (maximized), producing severe scroll jank. Set this to 1 to disable it.
# The Rust `run()` function sets this automatically on Linux; set it here to
# override or to apply it before `cargo tauri dev` starts the renderer process.
# WEBKIT_DISABLE_DMABUF_RENDERER=1
