{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coding Assistants",
  "mainBinaryName": "coding-assistants",
  "version": "../package.json",
  "identifier": "com.codingassistants.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Coding Assistants",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "publisher": "ACFHarbinger",
    "homepage": "https://github.com/ACFHarbinger/Coding-Assistants",
    "category": "DeveloperTool",
    "license": "MIT",
    "shortDescription": "Unified desktop control plane for coding assistants.",
    "longDescription": "Coding Assistants is a desktop application for orchestrating multiple AI coding assistants (Claude Code, Codex, Gemini) from a single interface, with a provider-native managed harness, persistent local settings, and an Android companion for remote session control.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
