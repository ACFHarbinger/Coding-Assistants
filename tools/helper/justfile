# tools/helper — presentation + project stats.

set shell := ["bash", "-c"]

bold := '\033[1m'
cyan := '\033[0;36m'
reset := '\033[0m'

# Print the project banner
[private]
_print_header:
    @printf '{{bold}}{{cyan}}Coding-Assistants{{reset}}\n'
    @printf 'Tauri Desktop App (Rust Backend · React/TypeScript Frontend · Kotlin Android Companion)\n\n'

# List every recipe across all sub-modules
help: _print_header
    @just --list --list-submodules

# Show project statistics
stats: _print_header
    @echo "Lines of code:"; tokei || true
