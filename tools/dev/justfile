# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Set up environment for all modules
[no-cd]
setup:
    @echo "Setting up dev environment..."
    npm ci
    pip install pre-commit || true
    pre-commit install --install-hooks || echo "pre-commit not available"
    @echo "Setup complete. Run 'just test-all' to verify."

# Update all dependencies
[no-cd]
update:
    @echo "Updating dependencies..."
    npm update
    cd src-tauri && cargo update

# Run pre-commit hooks manually
[no-cd]
pre-commit:
    pre-commit run --all-files

# Clean build artifacts across the app
[no-cd]
clean:
    rm -rf dist node_modules/.cache
    rm -rf src-tauri/target
    rm -rf android/build android/app/build

# Build cli and symlink `ca` into ~/.local/bin
[no-cd]
install-ca:
    cargo build -p cli
    mkdir -p "{{ env_var_or_default('HOME', '.') }}/.local/bin"
    ln -sfn "$(pwd)/target/debug/ca" "{{ env_var_or_default('HOME', '.') }}/.local/bin/ca"
    @echo "Installed: ~/.local/bin/ca → $(pwd)/target/debug/ca"
    @echo "Ensure PATH includes ~/.local/bin, then: hash -r && ca --help"

# Launch the keyboard-driven Ratatui terminal client from the current source.
[no-cd]
tui:
    cargo run -p cli -- tui

# Launch the Tauri application in development mode.
#
# GDK_BACKEND=x11 — Forces XWayland instead of native Wayland. Your desktop
# session sets GDK_BACKEND=wayland, which makes GTK use EGL/Wayland for
# rendering. NVIDIA's Wayland/EGL stack is immature and causes severe GPU
# stalls in WebKitGTK at large window sizes. XWayland uses NVIDIA's GLX
# (X11) path, which is stable and fast. Explicitly overriding here wins
# over the session default.
#
# WEBKIT_DISABLE_DMABUF_RENDERER=1 — Belt-and-suspenders: even under X11,
# newer WebKitGTK may probe for DMA-BUF. Keep it off.
#
# Snap library-path leak — VS Code's snap wrapper rewrites GTK_PATH,
# GTK_EXE_PREFIX, GTK_IM_MODULE_FILE, GSETTINGS_SCHEMA_DIR, LOCPATH,
# XDG_DATA_DIRS/XDG_DATA_HOME, GIO_MODULE_DIR, etc. to point at
# /snap/code/<rev>/... and ~/snap/code/<rev>/... before spawning its
# integrated terminal — so a `LD_LIBRARY_PATH`-only, `/snap/`-prefix-only
# filter misses both the actual affected variable set and the
# `$HOME/snap/...` path shape entirely. WebKitGTK's NetworkProcess then
# dlopens a snap-scoped libpthread against the system glibc and dies with:
#   undefined symbol: __libc_pthread_init, version GLIBC_PRIVATE
#
# The robust fix: VS Code's snap wrapper saves the pre-snap value of every
# variable it touches into a `<VAR>_VSCODE_SNAP_ORIG` sibling (empty string
# if it was originally unset) before overriding it. Restore from those
# directly — exact and complete, no guessing at variable names — then, as
# a fallback for non-VS-Code snap contamination (any other snap-launched
# terminal), also strip `/snap/*` and `$HOME/snap/*` entries from a
# smaller set of known linker/module-path vars.
[no-cd]
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    while IFS= read -r -d '' entry; do
        name="${entry%%=*}"
        case "${name}" in
            *_VSCODE_SNAP_ORIG)
                base="${name%_VSCODE_SNAP_ORIG}"
                value="${entry#*=}"
                if [[ -n "${value}" ]]; then
                    export "${base}=${value}"
                else
                    unset "${base}"
                fi
                ;;
        esac
    done < <(env -0)
    filter_snap_paths() {
        local value="${1-}"
        local out=""
        local IFS=':'
        local -a parts
        read -ra parts <<< "${value}"
        local p
        for p in "${parts[@]}"; do
            [[ -z "${p}" ]] && continue
            [[ "${p}" == /snap/* || "${p}" == "${HOME}/snap/"* ]] && continue
            if [[ -z "${out}" ]]; then
                out="${p}"
            else
                out="${out}:${p}"
            fi
        done
        printf '%s' "${out}"
    }
    for var in LD_LIBRARY_PATH GTK_PATH GI_TYPELIB_PATH GIO_MODULE_DIR LD_PRELOAD \
        GTK_EXE_PREFIX GTK_IM_MODULE_FILE GSETTINGS_SCHEMA_DIR LOCPATH \
        XDG_DATA_DIRS XDG_DATA_HOME; do
        if [[ -n "${!var-}" ]]; then
            filtered="$(filter_snap_paths "${!var}")"
            if [[ -n "${filtered}" ]]; then
                export "${var}=${filtered}"
            else
                unset "${var}"
            fi
        fi
    done
    export GDK_BACKEND=x11
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
    npm run tauri dev
