# tools/build — compile the app (frontend + Rust backend + Android companion).

set shell := ["bash", "-c"]

# Build everything
[no-cd]
all: frontend backend

[no-cd]
frontend:
    npm run build

[no-cd]
backend:
    #!/usr/bin/env bash
    set -euo pipefail
    bash tools/dev/ensure-linux-dev-libs.sh
    # shellcheck disable=SC1091
    source "${HOME}/.local/share/coding-assistants/dev-env.sh"
    bash tools/dev/stage-sidecars.sh release
    cd src-tauri && cargo build --release

[no-cd]
android:
    cd android && ./gradlew assembleDebug
